# Copy this file to ".env" and fill in the values. Never share or commit ".env".

# --- Admin login (open /admin in the browser) ---
ADMIN_USERNAME=admin
# Choose a strong password (8+ characters). Admin login stays disabled until you change this.
ADMIN_PASSWORD=change-me-please

# --- Owner WhatsApp number (digits, international format, e.g. 923131498344) ---
# You can also change this from Admin > "WhatsApp & Excel" -> Save (it rewrites this line).
OWNER_WHATSAPP=923131498344

# --- Production database (Neon PostgreSQL) ---
# Paste the Neon connection string here on Render. Leave blank for local file storage.
DATABASE_URL=
# Keep SSL enabled for Neon. Use PGSSL=disable only for a local non-SSL PostgreSQL server.
PGSSL=require
PGPOOL_MAX=5

# --- Security ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# This app signs secure sessions with this secret (JWT-style HMAC signing).
SESSION_SECRET=

# --- Optional ---
# PORT=3000
# DATA_DIR=data
# Cloudinary is reserved for production image storage; current local uploads use DATA_DIR/uploads.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
